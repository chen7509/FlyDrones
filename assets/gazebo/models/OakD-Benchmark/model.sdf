<?xml version="1.0"?>
<sdf version="1.9">
  <model name="OakD-Benchmark">
    <link name="camera_link">
      <inertial><mass>0.061</mass><inertia><ixx>0.0000460804</ixx><iyy>0.0000055421</iyy><izz>0.0000436519</izz></inertia></inertial>
      <collision name="body"><geometry><box><size>0.0175 0.091 0.028</size></box></geometry></collision>
      <visual name="body"><geometry><box><size>0.0175 0.091 0.028</size></box></geometry></visual>
      <sensor name="rgbd" type="rgbd_camera">
        <topic>/benchmark/rgbd</topic>
        <gz_frame_id>camera_link</gz_frame_id>
