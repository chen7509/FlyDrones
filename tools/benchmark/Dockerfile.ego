FROM ros:humble-ros-base-jammy
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
WORKDIR /ego_ws
RUN sed -i 's#http://archive.ubuntu.com#https://archive.ubuntu.com#g; s#http://security.ubuntu.com#https://security.ubuntu.com#g' /etc/apt/sources.list && \
    find /etc/apt/sources.list.d -type f -exec sed -i 's#http://packages.ros.org#https://packages.ros.org#g' {} + && \
    printf 'Acquire::Retries "5";\nAcquire::https::Timeout "60";\n' > /etc/apt/apt.conf.d/80-benchmark-network
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=60 update && \
    apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=60 \
    install -y --no-install-recommends \
    python3-colcon-common-extensions python3-rosdep \
    ros-humble-rmw-cyclonedds-cpp libarmadillo-dev \
    libpcl-dev libeigen3-dev python3-pip
COPY src /ego_ws/src
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    source /opt/ros/humble/setup.bash && rosdep update && \
    apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=60 update && \
    rosdep install --from-paths src --ignore-src -r -y \
      --skip-keys "Eigen3 PCL Boost Armadillo" && \
    colcon build --symlink-install --parallel-workers 2 --cmake-args -DCMAKE_BUILD_TYPE=Release
CMD ["bash", "-lc", "source /opt/ros/humble/setup.bash && source /ego_ws/install/setup.bash && ros2 pkg executables ego_planner"]
